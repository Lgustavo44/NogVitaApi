# Copie para .env (que fica fora do Git) e preencha. Usado só pelo docker-compose.yml, no ambiente local.

# A senha do Postgres do compose (um banco só local, descartável).
POSTGRES_PASSWORD=

# A chave de assinatura dos tokens: 32 bytes aleatórios, em base64. Para gerar uma:
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 32
JWT_SECRET_KEY=

# O administrador inicial, criado na primeira subida. O CPF precisa ser válido, e a senha ter pelo menos 15 caracteres.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@nogvita.local
ADMIN_CPF=
ADMIN_PASSWORD=
